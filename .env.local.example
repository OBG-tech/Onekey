# 本文件仅为示例，请复制为 .env.local 并填写你自己的 Key。
# 注意：.env.local 已被 .gitignore 忽略，避免误提交。

# Qwen / DashScope
DASHSCOPE_API_KEY=

# 可选：LLM 设置（脚本默认 LLM_PROVIDER=qwen, LLM_MODEL=qwen3-max）
# LLM_PROVIDER=qwen
# LLM_MODEL=qwen3-max

# 可选：ASR 设置（脚本默认优先 fireredasr）
# ASR_PROVIDER=fireredasr
# FIREREDASR_MODEL_DIR=pretrained_models/FireRedASR-AED-L

# 可选：关键时刻时间窗（秒）
# 默认前后各 15 秒；如需更长/更短可在此覆盖
# KEY_MOMENT_BEFORE_SECONDS=15
# KEY_MOMENT_AFTER_SECONDS=15

# 可选：麦克风缓冲（秒）
# 关键时刻需要覆盖“前后窗口 + 余量”，默认 60 秒
# MIC_BUFFER_SECONDS=60
